{
  "redirects": [
    {
      "source": "/empire-life-dashboard",
      "destination": "/apps/empire-life-dashboard",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/admin-(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/admin-content.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/admin-health",
      "schedule": "0 14 * * *"
    }
  ]
}
